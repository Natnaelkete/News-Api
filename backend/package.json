    "prisma": "^5.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/client": "^5.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.33",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "mime": "^2.6.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
